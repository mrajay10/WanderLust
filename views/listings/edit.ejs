<% layout("/layouts/boilerplate") %>
<body>
    <div class="row">
        <div class="col-8 offset-2 mt-3">
            
            <h3>Edit your listing</h3> 
            <form method="POST" action="/listings/<%= listing._id %>?_method=PUT" novalidate class="needs-validation">
                <div class="mb-3">
                    <label for="title" class="form-label">Title</label>
                    <input name="listing[title]" 
                    value="<%= listing.title %>"
                    type="text" 
                    class="form-control" 
                    id="title" 
                    required>
                    <div class="valid-feedback">Good</div>
                </div>
                <div class="mb-3">
                    <label for="description" class="form-label">Description</label>
                    <textarea name="listing[description]"  
                    type="text" 
                    class="form-control" 
                    id="description" required>
                    <%= listing.description %>
                    </textarea>
                     <div class="invalid-feedback">Please, write the description in short form.</div>
                </div class="mb-3">
                <div>
                    <label for="image" class="form-label">Image</label>
                    <input name="listing[image]" 
                    type="text" 
                    class="form-control"
                    id="image"
                    value="<%= listing.image %>"
                    required
                    >
                </div class="mb-3">
                <div class="row">
                    <div class="mb-3 col-md-4">
                        <label for="price" class="form-label">Price</label>
                        <input name="listing[price]" 
                        type="number"
                        class="form-control"
                        id="price"
                        value="<%= listing.price %>"
                        required
                        >
                        <div class="invalid-feedback">Price should be valid!</div>
                    </div>
                    <div class="mb-3 col-md-8">
                        <label for="country" class="form-label">Country</label>
                        <input name="listing[country]"
                        type="text" 
                        class="form-control"
                        id="country"
                        value="<%= listing.country %>"
                        required
                        >
                        <div class="invalid-feedback">Country should be valid!</div>
                    </div>
                </div>
                
                <div class="mb-3">
                    <label for="location" class="form-label">Location</label>
                    <input name="listing[location]"  
                        type="text"
                        class="form-control"
                        id="location"
                        value="<%= listing.location %>"
                        required
                        >
                        <div class="invalid-feedback">Location should be valid!</div>
                </div>
                <button class="btn btn-dark edit-btn mt-2 mb-3">Edit</button>
                
            </form>
        </div>
    </div>
</body>
